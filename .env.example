# --- WeatherGPT Environment Variables ---

# API
DEBUG=false

# Database (PostGIS + TimescaleDB on single Postgres)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/weathergpt

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Object Store (MinIO)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=weathergpt

# LLM
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
INTENT_MODEL=gpt-4o-mini

# Bhashini (Voice + Translation)
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# Firebase Cloud Messaging
FCM_CREDENTIALS_PATH=

# Open-Meteo (no key needed)
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1

# IMD
IMD_BASE_URL=https://mausam.imd.gov.in/api
