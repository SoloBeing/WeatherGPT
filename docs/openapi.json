  "components": {
    "schemas": {
      "AlertRecord": {
        "properties": {
          "alert_id": {
            "type": "string",
            "title": "Alert Id",
            "description": "Unique CAP alert identifier"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Source of the alert, e.g. sachet-ndma, imd",
            "default": "sachet-ndma"
          },
          "sender": {
            "type": "string",
            "title": "Sender",
            "description": "Agency issuing the alert, e.g. NDMA, IMD, SDMA"
          },
          "sent_at": {
            "type": "string",
            "format": "date-time",
            "title": "Sent At",
            "description": "Timestamp when the alert was published"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "Status: Actual, Exercise, Draft, Test",
            "default": "Actual"
          },
          "msg_type": {
            "type": "string",
            "title": "Msg Type",
            "description": "Message type: Alert, Update, Cancel",
            "default": "Alert"
          },
          "event": {
            "type": "string",
