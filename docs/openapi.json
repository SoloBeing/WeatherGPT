            "description": "Urgency: Immediate, Expected, Future, Past, Unknown",
            "default": "Expected"
          },
          "severity": {
            "type": "string",
            "title": "Severity",
            "description": "Severity level: Extreme (Red), Severe (Orange), Moderate (Yellow), Minor, Unknown"
          },
          "certainty": {
            "type": "string",
